<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Кафе "Уют"</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      margin-top: 100px;
      background: #f9f9f9;
    }
    h1 {
      color: #d35400;
      font-size: 2.5em;
    }
    .btn {
      display: inline-block;
      margin: 15px;
      padding: 12px 24px;
      font-size: 1.1em;
      background: #e67e22;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      cursor: pointer;
      border: none;
    }
    .btn:hover { background: #d35400; }
    .btn:disabled { background: #ccc; cursor: not-allowed; }
  </style>
</head>
<body>
  <h1>Кафе "Уют"</h1>
  <a href="/menu" class="btn">Выбор блюда</a>
  <button class="btn" disabled>Акции</button>
  <button class="btn" disabled>Оставить отзыв</button>
</body>
</html>